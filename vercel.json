{
  "version": 2,
  "functions": {
    "api/*.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/set-webhook",
      "destination": "/api/webhook?setWebhook=true"
    },
    {
      "source": "/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/telegram-webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/((?!public/|api/).*)",
      "destination": "/public/$1"
    }
  ]
}