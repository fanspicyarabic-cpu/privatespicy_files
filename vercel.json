{
  "version": 2,
  "rewrites": [
    {
      "source": "/set-webhook",
      "destination": "/api/webhook?setWebhook=true"
    },
    {
      "source": "/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/telegram-webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/api/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!public/|api/).*)",
      "destination": "/public/$1"
    }
  ]
}