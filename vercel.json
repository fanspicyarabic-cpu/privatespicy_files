{
  "version": 2,
  "builds": [
    {
      "src": "api/webhook.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/test.js",
      "use": "@vercel/node"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/set-webhook",
      "dest": "/api/webhook.js?setWebhook=true"
    },
    {
      "source": "/webhook",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/telegram-webhook",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/api/test",
      "dest": "/api/test.js"
    },
    {
      "src": "/api/webhook",
      "dest": "/api/webhook.js"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}